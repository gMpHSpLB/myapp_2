SHELL := /bin/bash

# ------------------------------------------------------------------------------
# Global config: namespaces for this tutorial
# ------------------------------------------------------------------------------
NAMESPACE_ALPHA := team-alpha
NAMESPACE_BETA  := team-beta
MYAPP_NS       	:= $(NAMESPACE_ALPHA)

RED    := \033[1;31m
YELLOW := \033[1;33m
GREEN  := \033[1;32m
CYAN   := \033[1;36m
RESET  := \033[0m

# ------------------------------------------------------------------------------
# Explicitly check CNI before proceeding
# Creating a NetworkPolicy resource without a controller that implements it will
# have no effect. You need Calico / Cilium / Antrea / Weave, etc. [web:2][web:24]
# ------------------------------------------------------------------------------
.PHONY: check-netpol-support
check-netpol-support: ## Check if CNI supports NetworkPolicy (Calico/Cilium/Antrea/etc.).
	@echo "Checking for NetworkPolicy-capable CNI in kube-system..."
	@kubectl get pods -n kube-system | grep -Ei 'calico|cilium|antrea|weave' || \
		( printf '$(RED)%s$(RESET)\n' \
			"ERROR: No NetworkPolicy-capable CNI detected (Calico/Cilium/Antrea/etc.)." \
			"       NetworkPolicy YAML will be accepted but NOT enforced." \
			"       For Minikube, restart with: minikube start --cni=calico"; \
		  exit 1 )

# ------------------------------------------------------------------------------
# Apply: namespaces
# ------------------------------------------------------------------------------
.PHONY: apply-namespaces
apply-namespaces: ## Apply namespaces team-alpha and team-beta (no NetworkPolicy yet).
	# File: resources/namespace/team-namespaces.yaml
	#  - Namespace: team-alpha
	#  - Namespace: team-beta
	kubectl apply -f resources/namespace/team-namespaces.yaml

# ------------------------------------------------------------------------------
# Apply: pods in both namespaces
# ------------------------------------------------------------------------------
.PHONY: apply-pods
apply-pods: ## Apply server/client pods in team-alpha and team-beta, then wait until Ready.
	# Apply team-alpha pods:
	kubectl apply -f resources/pod/$(NAMESPACE_ALPHA)/server/pod.yaml
	kubectl apply -f resources/pod/$(NAMESPACE_ALPHA)/server/service.yaml
	kubectl apply -f resources/pod/$(NAMESPACE_ALPHA)/client/pod.yaml

	# Apply team-beta pods:
	kubectl apply -f resources/pod/$(NAMESPACE_BETA)/server/pod.yaml
	kubectl apply -f resources/pod/$(NAMESPACE_BETA)/server/service.yaml
	kubectl apply -f resources/pod/$(NAMESPACE_BETA)/client/pod.yaml

	# Wait for pods to be Ready (Services are instant once pods exist).
	kubectl wait --for=condition=Ready pod/alpha-server -n $(NAMESPACE_ALPHA) --timeout=120s
	kubectl wait --for=condition=Ready pod/alpha-client -n $(NAMESPACE_ALPHA) --timeout=120s
	kubectl wait --for=condition=Ready pod/beta-server  -n $(NAMESPACE_BETA)  --timeout=120s
	kubectl wait --for=condition=Ready pod/beta-client  -n $(NAMESPACE_BETA)  --timeout=120s

# ------------------------------------------------------------------------------
# Apply: default-deny policies in both namespaces
# ------------------------------------------------------------------------------
.PHONY: apply-default-deny
apply-default-deny: ## Apply default-deny ingress+egress in team-alpha and team-beta.
	# Each default-deny policy:
	#  - apiVersion: networking.k8s.io/v1
	#  - kind: NetworkPolicy
	#  - podSelector: {}  -> selects ALL pods in the namespace
	#  - policyTypes:     -> both Ingress and Egress
	#  - no ingress/egress rules -> deny everything by default
	#
	# Once a pod is selected by a NetworkPolicy, it only accepts connections
	# explicitly allowed by *some* policy; everything else is denied. [web:2][web:24]
	kubectl apply -f resources/netpol/team-alpha/team-alpha-default-deny-all.yaml
	kubectl apply -f resources/netpol/team-beta/team-beta-default-deny-all.yaml

	# Optional: show policies after default-deny
	kubectl get networkpolicy -n $(NAMESPACE_ALPHA)
	kubectl get networkpolicy -n $(NAMESPACE_BETA)

# ------------------------------------------------------------------------------
# Apply: Apply ingress-only default-deny
# “default-deny ingress” : all alpha pods now reject incoming connections unless 
#						   some other ingress policy allows them
# ------------------------------------------------------------------------------
.PHONY: apply-alpha-default-deny-ingress
apply-alpha-default-deny-ingress: ## Default-deny INGRESS only in team-alpha.
	# Block all incoming traffic to alpha pods; egress remains open. [web:2][web:1]
	kubectl apply -n $(NAMESPACE_ALPHA) -f resources/netpol/team-alpha/team-alpha-default-deny-ingress.yaml

	# Show policy so we can confirm it's applied.
	kubectl get networkpolicy -n $(NAMESPACE_ALPHA)

# ------------------------------------------------------------------------------
# Apply: Apply egress-only default-deny
# 	This isolates alpha pods for egress; they can no longer call anything 
#	(other pods, services, external IPs, DNS) unless an egress policy allows it.
# ------------------------------------------------------------------------------
.PHONY: apply-alpha-default-deny-egress
apply-alpha-default-deny-egress: ## Default-deny EGRESS only in team-alpha.
	# Block all outgoing traffic from alpha pods; ingress remains governed by existing policies. [web:2][web:1][web:128]
	kubectl apply -n $(NAMESPACE_ALPHA) -f resources/netpol/team-alpha/team-alpha-default-deny-egress.yaml

	# Show policy.
	kubectl get networkpolicy -n $(NAMESPACE_ALPHA)

# ------------------------------------------------------------------------------
# Apply: least-privilege bundle for team-alpha (client -> server + DNS egress)
# ------------------------------------------------------------------------------
.PHONY: apply-least-privilege
apply-least-privilege: ## Allow alpha-client -> alpha-server + DNS egress in team-alpha.
	# Ingress: alpha-client -> alpha-server on TCP 5678
	kubectl apply -f resources/netpol/team-alpha/team-alpha-allow-client-to-server.yaml

	# Egress: alpha-client -> alpha-server on TCP 5678
	kubectl apply -f resources/netpol/team-alpha/team-alpha-allow-client-egress-to-server.yaml

	# Egress: all alpha pods -> CoreDNS (kube-dns) on TCP/UDP 53
	kubectl apply -f resources/netpol/team-alpha/team-alpha-allow-dns-egress.yaml

	# 1. Check DNS resolution from alpha-client
	kubectl exec -n $(NAMESPACE_ALPHA) alpha-client -- \
		nslookup alpha-server.$(NAMESPACE_ALPHA).svc.cluster.local

	# 2. Direct IP curl: alpha-client -> alpha-server ClusterIP, TCP 5678
	ALPHA_IP=$(kubectl get svc alpha-server -n team-alpha -o jsonpath='{.spec.clusterIP}')
	kubectl exec -n team-alpha alpha-client -- sh -c "curl -sS --max-time 3 http://${ALPHA_IP}:5678"

# ------------------------------------------------------------------------------
# Apply: least-privilege allow for team-alpha (client -> server) – standalone
# ------------------------------------------------------------------------------
.PHONY: apply-allow-client-to-server
apply-allow-client-to-server: ## Allow only team-alpha client to reach team-alpha server on TCP 5678.
	# Effect:
	#  - alpha-client  -> alpha-server on TCP 5678: ALLOWED
	#  - beta-client   -> alpha-server: BLOCKED (namespace isolation)
	#  - any other pod -> alpha-server: BLOCKED
	kubectl apply -f resources/netpol/team-alpha/team-alpha-allow-client-to-server.yaml

# ------------------------------------------------------------------------------
# Apply: DNS egress for team-alpha (optional standalone)
# ------------------------------------------------------------------------------
.PHONY: apply-allow-dns-egress
apply-allow-dns-egress: ## Allow DNS egress from team-alpha pods (labels may need adjustment).
	# NOTE: The actual labels for your cluster's DNS pods may differ.
	# Adjust namespaceSelector/podSelector if needed. [web:2][web:24]
	kubectl apply -f resources/netpol/team-alpha/team-alpha-allow-dns-egress.yaml

# ------------------------------------------------------------------------------
# Test: baseline connectivity (NO NetworkPolicy applied yet)
# ------------------------------------------------------------------------------
.PHONY: test-baseline-connectivity
test-baseline-connectivity: ## Test connectivity before any NetworkPolicy (expect ALLOWED everywhere).
	@printf '$(YELLOW)%s$(RESET)\n' "=== Baseline: NO NetworkPolicy ==="

	@printf '$(CYAN)%s$(RESET)\n' "Test 1: alpha-client -> alpha-server (same namespace, expect ALLOWED)"
	kubectl exec -n $(NAMESPACE_ALPHA) alpha-client -- \
		curl -sS --max-time 3 http://alpha-server:5678 || \
		printf '$(RED)%s$(RESET)\n' "FAILED (unexpected; should be allowed)"

	@echo
	@printf '$(CYAN)%s$(RESET)\n' "Test 2: beta-client -> beta-server (same namespace, expect ALLOWED)"
	kubectl exec -n $(NAMESPACE_BETA) beta-client -- \
		curl -sS --max-time 3 http://beta-server:5678 || \
		printf '$(RED)%s$(RESET)\n' "FAILED (unexpected; should be allowed)"

	@echo
	@printf '$(CYAN)%s$(RESET)\n' "Test 3: beta-client -> alpha-server (cross-namespace, expect ALLOWED by default)"
	kubectl exec -n $(NAMESPACE_BETA) beta-client -- \
		curl -sS --max-time 3 http://alpha-server.$(NAMESPACE_ALPHA).svc.cluster.local:5678 || \
		printf '$(RED)%s$(RESET)\n' "FAILED (unexpected; should be allowed)"

# ------------------------------------------------------------------------------
# Test: connectivity under default-deny in both namespaces
# ------------------------------------------------------------------------------
.PHONY: test-default-deny-connectivity
test-default-deny-connectivity: ## Test connectivity with default-deny in place (expect BLOCKED everywhere).
	@printf '$(YELLOW)%s$(RESET)\n' "=== Default-deny: team-alpha and team-beta ==="

	@printf '$(CYAN)%s$(RESET)\n' "Test 1: alpha-client -> alpha-server (same namespace, expect BLOCKED)"
	kubectl exec -n $(NAMESPACE_ALPHA) alpha-client -- \
		curl -sS --max-time 3 http://alpha-server:5678 && \
		printf '$(RED)%s$(RESET)\n' "FAILED (UNEXPECTED: traffic allowed)" || \
		printf '$(GREEN)%s$(RESET)\n' "OK: blocked as expected"

	@echo
	@printf '$(CYAN)%s$(RESET)\n' "Test 2: beta-client -> beta-server (same namespace, expect BLOCKED)"
	kubectl exec -n $(NAMESPACE_BETA) beta-client -- \
		curl -sS --max-time 3 http://beta-server:5678 && \
		printf '$(RED)%s$(RESET)\n' "FAILED (UNEXPECTED: traffic allowed)" || \
		printf '$(GREEN)%s$(RESET)\n' "OK: blocked as expected"

	@echo
	@printf '$(CYAN)%s$(RESET)\n' "Test 3: beta-client -> alpha-server (cross-namespace, expect BLOCKED)"
	kubectl exec -n $(NAMESPACE_BETA) beta-client -- \
		curl -sS --max-time 3 http://alpha-server.$(NAMESPACE_ALPHA).svc.cluster.local:5678 && \
		printf '$(RED)%s$(RESET)\n' "FAILED (UNEXPECTED: traffic allowed)" || \
		printf '$(GREEN)%s$(RESET)\n' "OK: blocked as expected"

# ------------------------------------------------------------------------------
# Test: behavior under ingress-only default-deny
#	Under this policy:
#		alpha pods cannot be reached,
#		but alpha pods can still call out to others.
# ------------------------------------------------------------------------------
.PHONY: test-alpha-default-deny-ingress
test-alpha-default-deny-ingress: ## Test alpha behavior with INGRESS-only default-deny.
	@printf '$(YELLOW)%s$(RESET)\n' "=== team-alpha: INGRESS default-deny (Egress still open) ==="

	@printf '$(CYAN)%s$(RESET)\n' "Test 1: alpha-client -> alpha-server:5678/TCP (expect BLOCKED: ingress denied)"
	kubectl exec -n $(NAMESPACE_ALPHA) alpha-client -- \
		curl -sS --max-time 3 http://alpha-server:5678 && \
		printf '$(RED)%s$(RESET)\n' "FAILED: alpha-server ingress should be denied" || \
		printf '$(GREEN)%s$(RESET)\n' "OK: blocked as expected"

	@echo
	@printf '$(CYAN)%s$(RESET)\n' "Test 2: beta-client -> alpha-server:5678/TCP (expect BLOCKED: ingress denied)"
	kubectl exec -n $(NAMESPACE_BETA) beta-client -- \
		curl -sS --max-time 3 http://alpha-server.$(NAMESPACE_ALPHA).svc.cluster.local:5678 && \
		printf '$(RED)%s$(RESET)\n' "FAILED: alpha-server ingress should be denied" || \
		printf '$(GREEN)%s$(RESET)\n' "OK: blocked as expected"

	@echo
	@printf '$(CYAN)%s$(RESET)\n' "Test 3: alpha-client -> beta-server:5678/TCP (expect ALLOWED: egress still open)"
	BETA_IP=$$(kubectl get svc beta-server -n $(NAMESPACE_BETA) -o jsonpath='{.spec.clusterIP}'); \
	kubectl exec -n $(NAMESPACE_ALPHA) alpha-client -- \
		sh -c "curl -sS --max-time 3 http://$${BETA_IP}:5678" && \
		printf '$(GREEN)%s$(RESET)\n' "OK: allowed (only ingress to alpha is denied)" || \
		printf '$(RED)%s$(RESET)\n' "UNEXPECTED: alpha egress should still be open"
# ------------------------------------------------------------------------------
# Test: behavior under egress-only default-deny
#	Under this policy:
#		alpha pods can still receive connections (if ingress allows),
#		but alpha pods cannot call out, including DNS.
# 
# Because egress is denied, the alpha-client cannot initiate traffic out, 
# so DNS and external HTTP(S) will fail unless you add an egress allow rule 
# such as team-alpha-allow-dns-egress.yaml
# ------------------------------------------------------------------------------
.PHONY: debug-alpha-server
debug-alpha-server: ## Show alpha-server Service, Endpoints, and pod readiness.
	@echo "=== alpha-server service ==="
	kubectl get svc alpha-server -n $(NAMESPACE_ALPHA) -o wide

	@echo
	@echo "=== alpha-server endpoints ==="
	kubectl get endpoints alpha-server -n $(NAMESPACE_ALPHA) -o wide

	@echo
	@echo "=== team-alpha pods ==="
	kubectl get pods -n $(NAMESPACE_ALPHA) -o wide --show-labels

	@echo
	@echo "=== alpha-server pod description ==="
	kubectl describe pod alpha-server -n $(NAMESPACE_ALPHA)

.PHONY: test-alpha-default-deny-egress
test-alpha-default-deny-egress: ## Test alpha behavior with EGRESS-only default-deny.
	@printf '$(YELLOW)%s$(RESET)\n' "=== team-alpha: EGRESS default-deny (Ingress may still be open) ==="

	@printf '$(CYAN)%s$(RESET)\n' "Test 1: alpha-client -> alpha-server:5678/TCP (expect BLOCKED: egress denied)"
	kubectl exec -n $(NAMESPACE_ALPHA) alpha-client -- \
		curl -sS --max-time 3 http://alpha-server:5678 && \
		printf '$(RED)%s$(RESET)\n' "FAILED: alpha-client egress should be denied" || \
		printf '$(GREEN)%s$(RESET)\n' "OK: blocked as expected"

	@echo
	@printf '$(CYAN)%s$(RESET)\n' "Test 2: beta-client -> alpha-server:5678/TCP (expect BLOCKED: alpha ingress is denied)"
	ALPHA_IP=$$(kubectl get svc alpha-server -n $(NAMESPACE_ALPHA) -o jsonpath='{.spec.clusterIP}'); \
	echo "ALPHA_IP=$${ALPHA_IP}"; \
	kubectl exec -n $(NAMESPACE_BETA) beta-client -- \
		curl -v --connect-timeout 3 --max-time 5 http://$${ALPHA_IP}:5678 && \
		printf '$(RED)%s$(RESET)\n' "FAILED: alpha ingress should be denied" || \
		printf '$(GREEN)%s$(RESET)\n' "OK: blocked as expected"

	@echo
	@printf '$(CYAN)%s$(RESET)\n' "Test 3: alpha-client -> DNS / external (expect BLOCKED: egress denied)"
	kubectl exec -n $(NAMESPACE_ALPHA) alpha-client -- \
		sh -c 'nslookup alpha-server.$(NAMESPACE_ALPHA).svc.cluster.local || curl -sS --max-time 3 https://example.com >/dev/null' && \
		printf '$(RED)%s$(RESET)\n' "FAILED: alpha egress should be denied (including DNS/external)" || \
		printf '$(GREEN)%s$(RESET)\n' "OK: blocked as expected (egress denied)"

# ------------------------------------------------------------------------------
# Test: connectivity after least-privilege allow for team-alpha
# ------------------------------------------------------------------------------
.PHONY: test-least-privilege-connectivity
test-least-privilege-connectivity: ## Test least-privilege: only alpha-client -> alpha-server is allowed.
	@printf '$(YELLOW)%s$(RESET)\n' "=== Least-privilege: allow ONLY alpha-client -> alpha-server on TCP 5678 ==="

	@printf '$(CYAN)%s$(RESET)\n' "Test 1: alpha-client -> alpha-server (expect ALLOWED)"

	# Show policies in team-alpha
	kubectl get networkpolicy -n $(NAMESPACE_ALPHA)

	# Describe each policy
	kubectl describe networkpolicy -n $(NAMESPACE_ALPHA) team-alpha-default-deny-all
	kubectl describe networkpolicy -n $(NAMESPACE_ALPHA) team-alpha-allow-client-to-server
	kubectl describe networkpolicy -n $(NAMESPACE_ALPHA) team-alpha-allow-client-egress-to-server
	kubectl describe networkpolicy -n $(NAMESPACE_ALPHA) team-alpha-allow-dns-egress

	# Show pod and service labels
	kubectl get pods -n $(NAMESPACE_ALPHA) --show-labels
	kubectl get svc  -n $(NAMESPACE_ALPHA) -o wide --show-labels

	kubectl exec -n $(NAMESPACE_ALPHA) alpha-client -- \
		curl -sS --max-time 3 http://alpha-server:5678 && \
		printf '$(GREEN)%s$(RESET)\n' "OK: allowed as expected" || \
		printf '$(RED)%s$(RESET)\n' "FAILED: should be allowed"

	@echo
	@printf '$(CYAN)%s$(RESET)\n' "Test 2: beta-client -> beta-server (expect BLOCKED: no allow policy in team-beta)"
	kubectl exec -n $(NAMESPACE_BETA) beta-client -- \
		curl -sS --max-time 3 http://beta-server:5678 && \
		printf '$(RED)%s$(RESET)\n' "UNEXPECTED: traffic allowed" || \
		printf '$(GREEN)%s$(RESET)\n' "OK: blocked as expected"

	@echo
	@printf '$(CYAN)%s$(RESET)\n' "Test 3: beta-client -> alpha-server (expect BLOCKED: cross-namespace still denied)"
	kubectl exec -n $(NAMESPACE_BETA) beta-client -- \
		curl -sS --max-time 3 http://alpha-server.$(NAMESPACE_ALPHA).svc.cluster.local:5678 && \
		printf '$(RED)%s$(RESET)\n' "UNEXPECTED: traffic allowed" || \
		printf '$(GREEN)%s$(RESET)\n' "OK: blocked as expected"

# ------------------------------------------------------------------------------
# Test: DNS connectivity from team-alpha (optional)
# ------------------------------------------------------------------------------
.PHONY: test-dns-connectivity
test-dns-connectivity: ## Test DNS behavior from team-alpha pods (effect depends on DNS policy + labels).
	@printf '$(YELLOW)%s$(RESET)\n' "=== DNS connectivity from team-alpha ==="
	@printf '$(CYAN)%s$(RESET)\n' "Test: alpha-client -> external HTTPS endpoint (requires DNS + egress)"

	kubectl exec -n $(NAMESPACE_ALPHA) alpha-client -- \
		sh -c 'curl -sS --max-time 5 https://example.com >/dev/null' && \
		echo "Result: DNS + egress appear to be ALLOWED from team-alpha (policy + labels matched)." || \
		echo "Result: DNS and/or egress still BLOCKED (adjust DNS NetworkPolicy or labels)."

# -------------------------------------------------------------------------------------------------------
# 				myapp Network Policy
# -------------------------------------------------------------------------------------------------------
# target to validate below  assumptions
# What we are assuming
# 1. Ingress controller:
# 		- Namespace ingress-nginx exists.
# 		- There is a Deployment named ingress-nginx-controller in that namespace.
# 		- At least one pod in that deployment is Ready.

# 2. myapp:
# 		- Helm release myapp in namespace team-alpha has created:
# 			- a Service <release-name>-myapp or myapp depending on your release name and overrides.
# 		- The Service has port=80 and targetPort=80 (from values.yaml).
# 		- There is at least one Ready pod matching the Service selector (app.kubernetes.io/name, app.kubernetes.io/instance).

# 3. Postgres:
# 		- Namespace team-alpha contains a Service postgres.
# 		- That Service exposes port 5432/TCP.
#		- Its backing pods have label app=postgres (for your egress podSelector).
.PHONY: debug-myapp-env
debug-myapp-env: ## Check assumptions: ingress-nginx controller, myapp service, postgres service.
	@printf '$(YELLOW)%s$(RESET)\n' "=== Checking ingress-nginx controller ==="
	kubectl get ns ingress-nginx || \
		printf '$(RED)%s$(RESET)\n' "Namespace ingress-nginx NOT found"

	kubectl get deploy ingress-nginx-controller -n ingress-nginx || \
		printf '$(RED)%s$(RESET)\n' "Deployment ingress-nginx-controller NOT found in ingress-nginx"

	kubectl get pods -n ingress-nginx -l app.kubernetes.io/name=ingress-nginx --show-labels || \
		printf '$(RED)%s$(RESET)\n' "No pods matching ingress-nginx labels found"

	@printf '$(YELLOW)%s$(RESET)\n' "=== Checking myapp Service and pods in team-alpha ==="
	kubectl get svc -n $(NAMESPACE_ALPHA) -l app.kubernetes.io/name=myapp --show-labels || \
		printf '$(RED)%s$(RESET)\n' "myapp Service not found by label app.kubernetes.io/name=myapp"

	kubectl get svc myapp -n $(NAMESPACE_ALPHA) -o wide || \
		printf '$(RED)%s$(RESET)\n' "Service 'myapp' not found in team-alpha"

	kubectl get endpoints myapp -n $(NAMESPACE_ALPHA) -o wide || \
		printf '$(RED)%s$(RESET)\n' "Endpoints for Service 'myapp' missing in team-alpha"

	kubectl get pods -n $(NAMESPACE_ALPHA) -l app.kubernetes.io/name=myapp --show-labels || \
		printf '$(RED)%s$(RESET)\n' "No myapp pods with label app.kubernetes.io/name=myapp"

	@printf '$(YELLOW)%s$(RESET)\n' "=== Checking postgres Service in team-alpha ==="
	kubectl get svc postgres -n $(NAMESPACE_ALPHA) -o wide || \
		printf '$(RED)%s$(RESET)\n' "Service 'postgres' not found in team-alpha"

	kubectl get endpoints postgres -n $(NAMESPACE_ALPHA) -o wide || \
		printf '$(RED)%s$(RESET)\n' "Endpoints for Service 'postgres' missing in team-alpha"

	kubectl get pods -n $(NAMESPACE_ALPHA) -l app=postgres --show-labels || \
		printf '$(RED)%s$(RESET)\n' "No postgres pods with label app=postgres"

.PHONY: apply-myapp-netpol
apply-myapp-netpol: ## Apply myapp ingress+egress NetworkPolicies in team-alpha.
	# Ingress: allow traffic only from ingress-nginx namespace to myapp on port 80/TCP.
	kubectl apply -f resources/netpol/myapp/myapp-allow-ingress.yaml

	# Egress: allow traffic only from myapp to Postgres pods on port 5432/TCP.
	kubectl apply -f resources/netpol/myapp/myapp-allow-egress.yaml

	kubectl apply -f resources/netpol/myapp/postgres/myapp-allow-postgres-ingress.yaml
	# Show policies for confirmation.
	kubectl get networkpolicy -n $(MYAPP_NS)

# -------------------------------------------------------------------------------------------------------
#   myapp external payment API egress (ipBlock on TCP 443)
#   Demonstrates egress to a specific external CIDR with one IP excluded.
# -------------------------------------------------------------------------------------------------------
.PHONY: apply-myapp-allow-external-payment-api
apply-myapp-allow-external-payment-api: ## Allow myapp egress to external payment API CIDR on TCP 443 (ipBlock).
	# File: resources/netpol/myapp/myapp-allow-external-payment-api.yaml
	#  - Allows myapp pods (app=myapp) to egress to 203.0.113.0/24 on TCP 443, except 203.0.113.5/32.
	#  - Pattern for external payment APIs / webhooks using ipBlock. [web:237][web:256]
	kubectl apply -f resources/netpol/myapp/myapp-allow-external-payment-api.yaml

	# Show policies for confirmation.
	kubectl get networkpolicy -n $(MYAPP_NS)
# -------------------------------------------------------------------------------------------------------
#	 Tests for myapp ingress and egress
# These tests assume:
# 	- Ingress controller: ingress-nginx namespace, Deployment ingress-nginx-controller.
# 	- myapp Service: name myapp in team-alpha, port 80.
# 	- Postgres: Service postgres in team-alpha, label app=postgres, port 5432.
# -------------------------------------------------------------------------------------------------------
# Test myapp ingress
.PHONY: test-myapp-ingress
test-myapp-ingress: ## Test myapp ingress: only ingress-nginx can reach myapp:80.
	@printf '$(YELLOW)%s$(RESET)\n' "=== myapp ingress test (team-alpha) ==="

	@printf '$(CYAN)%s$(RESET)\n' "Test 1: ingress-nginx -> myapp:80 (expect ALLOWED)"
	MYAPP_HOST="myapp.$(MYAPP_NS).svc.cluster.local"; \
	kubectl exec -n ingress-nginx deploy/ingress-nginx-controller -- \
		curl -sS --max-time 5 http://$${MYAPP_HOST}:80 && \
		printf '$(GREEN)%s$(RESET)\n' "OK: ingress-nginx can reach myapp" || \
		printf '$(RED)%s$(RESET)\n' "FAILED: ingress-nginx should be allowed to reach myapp"

	@echo
	@printf '$(CYAN)%s$(RESET)\n' "Test 2: beta-client -> myapp:80 (expect BLOCKED)"
	kubectl exec -n $(NAMESPACE_BETA) beta-client -- \
		curl -sS --max-time 5 http://myapp.$(MYAPP_NS).svc.cluster.local:80 && \
		printf '$(RED)%s$(RESET)\n' "FAILED: beta-client should NOT reach myapp" || \
		printf '$(GREEN)%s$(RESET)\n' "OK: blocked as expected"

# Test myapp egress
.PHONY: test-myapp-egress
test-myapp-egress: ## Test myapp egress: only Postgres:5432 should be reachable.
	@printf '$(YELLOW)%s$(RESET)\n' "=== myapp egress test (team-alpha) ==="

	# Find a myapp pod.
	MYAPP_POD=$$(kubectl get pod -n $(MYAPP_NS) -l app=myapp -o jsonpath='{.items[0].metadata.name}'); \
	POSTGRES_SVC="postgres.$(MYAPP_NS).svc.cluster.local"; \
	echo "MYAPP_POD=$${MYAPP_POD}, POSTGRES_SVC=$${POSTGRES_SVC}"; \
	kubectl exec -n $(MYAPP_NS) $$MYAPP_POD -- \
		sh -c "nc -vz $${POSTGRES_SVC} 5432 || curl -sS --connect-timeout 3 --max-time 5 http://$${POSTGRES_SVC}:5432" && \
		printf '$(GREEN)%s$(RESET)\n' "OK: myapp can reach Postgres:5432" || \
		printf '$(RED)%s$(RESET)\n' "FAILED: myapp should be allowed to reach Postgres:5432"

# -------------------------------------------------------------------------------------------------------
#   Debug pod and tests for myapp external payment API egress (ipBlock)
#   Uses a netshoot pod labelled app=myapp so existing policies apply.
# -------------------------------------------------------------------------------------------------------
.PHONY: create-myapp-debug
create-myapp-debug: ## Create myapp-debug netshoot pod in team-alpha for egress testing.
	@printf '$(YELLOW)%s$(RESET)\n' "=== Creating myapp-debug pod (netshoot, app=myapp) in $(MYAPP_NS) ==="
	kubectl run myapp-debug \
	  --image=nicolaka/netshoot \
	  --restart=Never \
	  -n $(MYAPP_NS) \
	  --labels="app=myapp" \
	  -- sleep 3600
	kubectl get pod -n $(MYAPP_NS) -l app=myapp --show-labels

.PHONY: delete-myapp-debug
delete-myapp-debug: ## Delete myapp-debug pod.
	@printf '$(YELLOW)%s$(RESET)\n' "=== Deleting myapp-debug pod in $(MYAPP_NS) ==="
	kubectl delete pod myapp-debug -n $(MYAPP_NS) --ignore-not-found=true

.PHONY: test-myapp-external-api-egress
test-myapp-external-api-egress: ## Test myapp external payment API egress (ipBlock) from myapp-debug pod.
	@printf '$(YELLOW)%s$(RESET)\n' "=== myapp external payment API egress test (team-alpha) ==="

	@printf '$(CYAN)%s$(RESET)\n' "Selecting a pod with app=myapp label for testing..."
	DEBUG_POD="$$(kubectl get pod -n $(MYAPP_NS) -l app=myapp -o jsonpath='{.items[0].metadata.name}')"; \
	printf '$(CYAN)%s$(RESET)\n' "Using pod $$DEBUG_POD"; \
	printf '$(CYAN)%s$(RESET)\n' "Test 1: Allowed IP 203.0.113.10:443 (within CIDR 203.0.113.0/24, not excluded)"; \
	kubectl exec -n team-alpha $DEBUG_POD -- nc -vz -w 3 203.0.113.10 443 \
  			&& printf '$(GREEN)%s$(RESET)\n' "Allowed by policy" \
  			|| printf '$(GREEN)%s$(RESET)\n' "Connect failed; policy may still have allowed it, but no endpoint is listening"
	printf '$(CYAN)%s$(RESET)\n' "Test 2: Excluded IP 203.0.113.5:443 (listed in 'except', should be BLOCKED)"; \
	kubectl exec -n team-alpha $DEBUG_POD -- nc -vz -w 3 203.0.113.5 443 \
  			&& printf '$(RED)%s$(RESET)\n' "Unexpected: should have been blocked" \
  			|| printf '$(GREEN)%s$(RESET)\n' "Blocked by policy or endpoint unreachable"
# ------------------------------------------------------------------------------
# Cleanup: remove namespaces (and everything inside them)
# ------------------------------------------------------------------------------
.PHONY: cleanup
cleanup: ## Delete namespaces team-alpha and team-beta and all related resources.
	kubectl delete namespace $(NAMESPACE_ALPHA) --ignore-not-found=true
	kubectl delete namespace $(NAMESPACE_BETA)  --ignore-not-found=true

