# Use Bash for shell commands in recipes.
# This gives us better shell features than plain sh.
SHELL := /bin/bash

# Default target
.DEFAULT_GOAL := help

# Self-documenting help: list targets with "##" comments
help: ## Show all available targets with short descriptions.
	# This target reads the Makefile and prints any line ending with ##.
	# Use this when you want to discover available commands quickly.
	# Expected output: a list of targets and one-line descriptions.
	@awk 'BEGIN {FS = ":.*##"; printf "\nUsage:\n  make <target>\n\nTargets:\n"} /^[a-zA-Z0-9_.-]+:.*##/ { printf "  %-28s %s\n", $$1, $$2 }' $(MAKEFILE_LIST)

# ---------- GLOBAL CONFIG --------------------------------------
RED    := \033[1;31m
YELLOW := \033[1;33m
GREEN  :="\033[1;32m"
CYAN   := \033[1;36m
RESET  := \033[0m

NAMESPACE_ALPHA := team-alpha

HELM_CHART_DIR := charts/myapp
MYAPP_RELEASE  := myapp
MYAPP_NS       := $(NAMESPACE_ALPHA)
MYAPP_VALUES   := charts/myapp/values.yaml


# --------------------------------------------------------------------------------------
# 				Install / upgrade myapp
# --------------------------------------------------------------------------------------
.PHONY: myapp-install
myapp-install: ## Install or upgrade myapp Helm release into team-alpha.
	# Ensure namespace exists.
	kubectl create namespace $(MYAPP_NS) --dry-run=client -o yaml | kubectl apply -f -

	# Install/upgrade myapp chart into team-alpha.
	helm upgrade --install $(MYAPP_RELEASE) $(HELM_CHART_DIR) \
		--namespace $(MYAPP_NS) \
		-f $(MYAPP_VALUES)

	# Wait for myapp deployment to be Ready.
	kubectl rollout status deployment/$(MYAPP_RELEASE) -n $(MYAPP_NS) --timeout=120s

# --------------------------------------------------------------------------------------
# 								Uninstall myapp
# --------------------------------------------------------------------------------------
.PHONY: myapp-uninstall
myapp-uninstall: ## Uninstall myapp Helm release from team-alpha.
	helm uninstall $(MYAPP_RELEASE) --namespace $(MYAPP_NS) || true

# --------------------------------------------------------------------------------------------------------
#	Target to install dummy Postgres
# --------------------------------------------------------------------------------------------------------
.PHONY: postgres-install
postgres-install: ## Install a simple Postgres Deployment+Service in team-alpha for NetworkPolicy tests.
	kubectl apply -f resources/pod/postgres/postgres.yaml

	# Wait for postgres pod to be Ready.
	kubectl rollout status deployment/postgres -n $(NAMESPACE_ALPHA) --timeout=120s

.PHONY: postgres-uninstall
postgres-uninstall: ## Remove the dummy Postgres resources from team-alpha.
	kubectl delete deployment postgres -n $(NAMESPACE_ALPHA) --ignore-not-found
	kubectl delete service postgres -n $(NAMESPACE_ALPHA) --ignore-not-found

